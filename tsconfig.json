{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "examples/*/src",
    "examples/*/bin",
    "examples/*/test",
    "interop/*.ts",
    "vitest.config.ts",
    "docs/snippets",
    "docs/test",
    "docs/*.ts"
  ]
}
