{
  "name": "@tessellog/witness",
  "version": "0.0.0",
  "description": "A C2SP tlog-witness for tessellog and other tlog-tiles logs, with a client for submitting checkpoints.",
  "keywords": [
    "transparency-log",
    "tlog-tiles",
    "tessera",
    "witness",
    "cosignature",
    "tlog-witness"
  ],
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "homepage": "https://github.com/markkevans/tessellog/tree/main/packages/witness#readme",
  "bugs": {
    "url": "https://github.com/markkevans/tessellog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markkevans/tessellog.git",
    "directory": "packages/witness"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tessellog/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "provenance": true
  }
}
