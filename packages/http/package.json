{
  "name": "@tessellog/http",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "repository": "github:markkevans/tessellog",
  "description": "A fetch-style HTTP handler for tessellog logs: add entries and serve tiles, bundles and checkpoints.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tessellog/appender": "workspace:*",
    "@tessellog/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  }
}
