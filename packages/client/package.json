{
  "name": "@tessellog/client",
  "version": "0.1.0",
  "description": "Fetches and verifies tessellog transparency logs over HTTP or from disk.",
  "keywords": [
    "transparency-log",
    "tlog-tiles",
    "tessera",
    "verification",
    "inclusion-proof",
    "consistency-proof"
  ],
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "homepage": "https://github.com/markkevans/tessellog/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/markkevans/tessellog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markkevans/tessellog.git",
    "directory": "packages/client"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tessellog/core": "workspace:*"
  },
  "devDependencies": {
    "@tessellog/appender": "workspace:*",
    "@tessellog/driver-posix": "workspace:*",
    "@tessellog/witness": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  }
}
