    "tlog-tiles",
    "tessera",
    "conformance",
    "vitest",
    "driver"
  ],
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "homepage": "https://github.com/markkevans/tessellog/tree/main/packages/driver-conformance#readme",
  "bugs": {
    "url": "https://github.com/markkevans/tessellog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markkevans/tessellog.git",
    "directory": "packages/driver-conformance"
  },
