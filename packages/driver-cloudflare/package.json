{
  "name": "@tessellog/driver-cloudflare",
  "version": "0.1.2",
  "description": "Stores a tessellog transparency log in Cloudflare R2, with D1 for sequencing, tree state and antispam.",
  "keywords": [
    "transparency-log",
    "tlog-tiles",
    "tessera",
    "cloudflare",
    "r2",
    "d1",
    "workers",
    "driver"
  ],
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "homepage": "https://github.com/markkevans/tessellog/tree/main/packages/driver-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/markkevans/tessellog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markkevans/tessellog.git",
    "directory": "packages/driver-cloudflare"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tessellog/appender": "workspace:*",
    "@tessellog/core": "workspace:*",
    "@tessellog/driver-object-store": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@noble/hashes": "^1.8.0",
    "@tessellog/driver-conformance": "workspace:*",
    "miniflare": "^4.20260730.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
