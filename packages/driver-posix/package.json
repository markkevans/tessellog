{
  "name": "@tessellog/driver-posix",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "repository": "github:markkevans/tessellog",
  "description": "Stores a tessellog transparency log in a POSIX directory at tlog-tiles paths.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tessellog/appender": "workspace:*",
    "@tessellog/core": "workspace:*",
    "@tessellog/witness": "workspace:*"
  },
  "devDependencies": {
    "@tessellog/driver-conformance": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
