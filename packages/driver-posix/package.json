{
  "name": "@tessellog/driver-posix",
  "version": "0.0.0",
  "description": "Stores a tessellog transparency log in a POSIX directory at tlog-tiles paths.",
  "keywords": [
    "transparency-log",
    "tlog-tiles",
    "tessera",
    "filesystem",
    "driver"
  ],
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "homepage": "https://github.com/markkevans/tessellog/tree/main/packages/driver-posix#readme",
  "bugs": {
    "url": "https://github.com/markkevans/tessellog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markkevans/tessellog.git",
    "directory": "packages/driver-posix"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tessellog/appender": "workspace:*",
    "@tessellog/core": "workspace:*",
    "@tessellog/witness": "workspace:*"
  },
  "devDependencies": {
    "@tessellog/driver-conformance": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
