{
  "name": "tessellog",
  "private": true,
  "license": "Apache-2.0",
  "author": "Mark Evans",
  "repository": "github:markkevans/tessellog",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "bench": "tsx packages/client/bench/streaming.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
